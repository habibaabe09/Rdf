<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47/"
     xml:base="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47/"
     xmlns:gr="http://purl.org/goodrelations/v1#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:schema="https://schema.org/"
     xmlns:untitled-ontology-47="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Purchase -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Purchase">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Customer"/>
        <rdfs:range rdf:resource="https://schema.org/Product"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#about -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#about">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#hasReview"/>
        <rdfs:domain rdf:resource="https://schema.org/Review"/>
        <rdfs:range rdf:resource="https://schema.org/Product"/>
        <rdfs:comment>reviws of product</rdfs:comment>
        <rdfs:label>about</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#approvedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#approvedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#approves"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#ReturnRequest"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Staff"/>
        <rdfs:comment>return request approval</rdfs:comment>
        <rdfs:label>approvedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#approves -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#approves">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Staff"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#ReturnRequest"/>
        <rdfs:comment>who approves the request</rdfs:comment>
        <rdfs:label>approves</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#belongsTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#belongsTo">
        <rdfs:domain rdf:resource="https://schema.org/Product"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Category"/>
        <rdfs:comment>product  of category</rdfs:comment>
        <rdfs:label>belongsTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#contains -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#contains">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Cart"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#CartItem"/>
        <rdfs:comment>cart cotaining</rdfs:comment>
        <rdfs:label>contains</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#delivers -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#delivers">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#DeliveryAgent"/>
        <rdfs:range rdf:resource="https://schema.org/Order"/>
        <rdfs:comment>who delivers the pacel</rdfs:comment>
        <rdfs:label>delivers</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#generatedFor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#generatedFor">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#hasInvoice"/>
        <rdfs:domain rdf:resource="https://schema.org/Invoice"/>
        <rdfs:range rdf:resource="https://schema.org/Order"/>
        <rdfs:comment>Generate Invoice for order</rdfs:comment>
        <rdfs:label>generatedFor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#has -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#has">
        <rdfs:domain rdf:resource="https://schema.org/Order"/>
        <rdfs:range rdf:resource="https://schema.org/OrderItem"/>
        <rdfs:comment>Represents a general relationship between two entities</rdfs:comment>
        <rdfs:label>has</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#hasAddress -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#hasAddress">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Customer"/>
                    <rdf:Description rdf:about="https://schema.org/Organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://schema.org/Address"/>
        <rdfs:comment>Links a customer with an address</rdfs:comment>
        <rdfs:label>hasAddress</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#hasBrand -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#hasBrand">
        <rdfs:domain rdf:resource="https://schema.org/Product"/>
        <rdfs:range rdf:resource="https://schema.org/Brand"/>
        <rdfs:comment>shows the brand of product</rdfs:comment>
        <rdfs:label>hasBrand</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#hasInvoice -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#hasInvoice">
        <rdfs:domain rdf:resource="https://schema.org/Order"/>
        <rdfs:range rdf:resource="https://schema.org/Invoice"/>
        <rdfs:comment>Connects an order with its brand</rdfs:comment>
        <rdfs:label>hasInvoice</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#hasPayment -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#hasPayment">
        <rdfs:domain rdf:resource="https://schema.org/Order"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Payment"/>
        <rdfs:comment>represents the payment associated with an order</rdfs:comment>
        <rdfs:label>hasPayment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#hasReview -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#hasReview">
        <rdfs:domain rdf:resource="https://schema.org/Product"/>
        <rdfs:range rdf:resource="https://schema.org/Review"/>
        <rdfs:comment>Links a product with reviews</rdfs:comment>
        <rdfs:label>hasReview</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#hasStatus -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#hasStatus">
        <rdfs:domain rdf:resource="https://schema.org/Order"/>
        <rdfs:range rdf:resource="https://schema.org/OrderStatus"/>
        <rdfs:comment>Shows the current status of an order</rdfs:comment>
        <rdfs:label>herStatus</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#listedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#listedIn">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#stores"/>
        <rdfs:domain rdf:resource="https://schema.org/Product"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Inventory"/>
        <rdfs:comment>Indicates the inventory in which aProduct  is listed</rdfs:comment>
        <rdfs:label>listedIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#makesPayment -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#makesPayment">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Customer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Payment"/>
        <rdfs:comment>Represents a customer making a payment For an order</rdfs:comment>
        <rdfs:label>makesPayment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#managecus -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#managecus">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Administrator"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Customer"/>
        <rdfs:comment>Represent the management of customer information by administrator</rdfs:comment>
        <rdfs:label>manageCus</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#manages -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#manages">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Seller"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Inventory"/>
        <rdfs:comment>Shows how seller manages the inventory</rdfs:comment>
        <rdfs:label>manages</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#managesOrder -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#managesOrder">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Staff"/>
        <rdfs:range rdf:resource="https://schema.org/Order"/>
        <rdfs:comment>Represents a management of customer orders by staff</rdfs:comment>
        <rdfs:label>managesOrder</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#ownedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#ownedBy">
        <owl:inverseOf rdf:resource="https://schema.org/owns"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Cart"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Customer"/>
        <rdfs:comment>Shows the ownership of cart</rdfs:comment>
        <rdfs:label>ownedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#placedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#placedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#placesOrder"/>
        <rdfs:domain rdf:resource="https://schema.org/Order"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Customer"/>
        <rdfs:comment>Indicates which customer placed the order</rdfs:comment>
        <rdfs:label>placedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#placesOrder -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#placesOrder">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Customer"/>
        <rdfs:range rdf:resource="https://schema.org/Order"/>
        <rdfs:comment>Represents a customer placing an order</rdfs:comment>
        <rdfs:label>placesOrder</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#rAbout -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#rAbout">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#ReturnRequest"/>
        <rdfs:range rdf:resource="https://schema.org/Product"/>
        <rdfs:comment>Return request for orderd product</rdfs:comment>
        <rdfs:label>rAbout</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#receivesRefund -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#receivesRefund">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#refundIssuedTo"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Customer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Refund"/>
        <rdfs:comment>Shows that a customer receives a refund</rdfs:comment>
        <rdfs:label>recievesRefund</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#refersTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#refersTo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#CartItem"/>
        <rdfs:range rdf:resource="https://schema.org/Product"/>
        <rdfs:comment>Indiicates  cart items refer to product</rdfs:comment>
        <rdfs:label>refersTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#refundIssuedTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#refundIssuedTo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Refund"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Customer"/>
        <rdfs:comment>Represents that a refund is issued to a customer</rdfs:comment>
        <rdfs:label>refundIssuedTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#requestsReturn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#requestsReturn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Customer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#ReturnRequest"/>
        <rdfs:comment>Customer  request to return a product</rdfs:comment>
        <rdfs:label>requestsReturn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#stores -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#stores">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Inventory"/>
        <rdfs:range rdf:resource="https://schema.org/Product"/>
        <rdfs:comment>Inventory stores products</rdfs:comment>
        <rdfs:label>stores</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#supplies -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#supplies">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Supplier"/>
        <rdfs:range rdf:resource="https://schema.org/Product"/>
        <rdfs:comment>Represents a supplying products by a supplier</rdfs:comment>
        <rdfs:label>supplies</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#suppliesTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#suppliesTo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Supplier"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Seller"/>
        <rdfs:comment>Showa that a supplier provied products to a seller</rdfs:comment>
        <rdfs:label>suppliesTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#useDelivery -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#useDelivery">
        <rdfs:domain rdf:resource="https://schema.org/ParcelDelivery"/>
        <rdfs:range rdf:resource="https://schema.org/DeliveryMethod"/>
        <rdfs:comment>Use of delivery</rdfs:comment>
        <rdfs:label>useDelivery</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#uses -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#uses">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Payment"/>
        <rdfs:range rdf:resource="https://schema.org/PaymentMethod"/>
        <rdfs:comment>uses of paymen method</rdfs:comment>
        <rdfs:label>uses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#writes -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#writes">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#writtenBy"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Customer"/>
        <rdfs:range rdf:resource="https://schema.org/Review"/>
        <rdfs:comment>Customer  writing a review</rdfs:comment>
        <rdfs:label>writes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#writtenBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#writtenBy">
        <rdfs:domain rdf:resource="https://schema.org/Review"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Customer"/>
        <rdfs:comment>Customer writes the review</rdfs:comment>
        <rdfs:label>writtenBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://schema.org/orderedItem -->

    <owl:ObjectProperty rdf:about="https://schema.org/orderedItem">
        <rdfs:domain rdf:resource="https://schema.org/OrderItem"/>
        <rdfs:range rdf:resource="https://schema.org/Product"/>
        <rdfs:comment>order items</rdfs:comment>
        <rdfs:label>orderedItem</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://schema.org/owns -->

    <owl:ObjectProperty rdf:about="https://schema.org/owns">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Customer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Cart"/>
        <rdfs:comment>Represents a ownership relationship</rdfs:comment>
        <rdfs:label>owns</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://schema.org/worksFor -->

    <owl:ObjectProperty rdf:about="https://schema.org/worksFor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Seller"/>
        <rdfs:range rdf:resource="https://schema.org/Brand"/>
        <rdfs:comment>seller worksfor brand</rdfs:comment>
        <rdfs:label>worksFor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#comment -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#comment">
        <rdfs:domain rdf:resource="https://schema.org/Review"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Review on products</rdfs:comment>
        <rdfs:label>comment</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#deliveryCost -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#deliveryCost">
        <rdfs:domain rdf:resource="https://schema.org/DeliveryMethod"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Cost of delivery</rdfs:comment>
        <rdfs:label>deliveryCost</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#quantity -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#quantity">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#CartItem"/>
                    <rdf:Description rdf:about="https://schema.org/OrderItem"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Number of iitems in cart</rdfs:comment>
        <rdfs:label>quantity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#refundAmount -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#refundAmount">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Refund"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Amount refunded</rdfs:comment>
        <rdfs:label>refundAmount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#refundDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#refundDate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Refund"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Date of refund</rdfs:comment>
        <rdfs:label>refundDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#refundReason -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#refundReason">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Refund"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The reason of refund</rdfs:comment>
        <rdfs:label>refundReason</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#returnReason -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#returnReason">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#ReturnRequest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Reson of return</rdfs:comment>
        <rdfs:label>returnReason</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#taxAmount -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#taxAmount">
        <rdfs:domain rdf:resource="https://schema.org/Invoice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Applied tax amount</rdfs:comment>
        <rdfs:label>taxAmount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#websiteURL -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#websiteURL">
        <rdfs:domain rdf:resource="https://schema.org/WebPage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>The url of website</rdfs:comment>
        <rdfs:label>websiteURL</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/addressRegion -->

    <owl:DatatypeProperty rdf:about="https://schema.org/addressRegion">
        <rdfs:domain rdf:resource="https://schema.org/Address"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Address of region</rdfs:comment>
        <rdfs:label>addressRegion</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/dateIssued -->

    <owl:DatatypeProperty rdf:about="https://schema.org/dateIssued">
        <rdfs:domain rdf:resource="https://schema.org/Invoice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>date issued for invoice</rdfs:comment>
        <rdfs:label>dateIssued</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/description -->

    <owl:DatatypeProperty rdf:about="https://schema.org/description">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Category"/>
                    <rdf:Description rdf:about="https://schema.org/Product"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>detail about category or product</rdfs:comment>
        <rdfs:label>description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/email -->

    <owl:DatatypeProperty rdf:about="https://schema.org/email">
        <rdfs:domain rdf:resource="http://purl.org/goodrelations/v1#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Email address of person</rdfs:comment>
        <rdfs:label>email</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/givenName -->

    <owl:DatatypeProperty rdf:about="https://schema.org/givenName">
        <rdfs:domain rdf:resource="http://purl.org/goodrelations/v1#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>name of person</rdfs:comment>
        <rdfs:label>givenName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/identifier -->

    <owl:DatatypeProperty rdf:about="https://schema.org/identifier">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Cart"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Customer"/>
                    <rdf:Description rdf:about="https://schema.org/Invoice"/>
                    <rdf:Description rdf:about="https://schema.org/Order"/>
                    <rdf:Description rdf:about="https://schema.org/Product"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Unique identification value</rdfs:comment>
        <rdfs:label>identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/inventoryLevel -->

    <owl:DatatypeProperty rdf:about="https://schema.org/inventoryLevel">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Inventory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Available stock quantity</rdfs:comment>
        <rdfs:label>inventoryLevel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/name -->

    <owl:DatatypeProperty rdf:about="https://schema.org/name">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Category"/>
                    <rdf:Description rdf:about="https://schema.org/Brand"/>
                    <rdf:Description rdf:about="https://schema.org/Product"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>name of product category and brand</rdfs:comment>
        <rdfs:label>name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/orderDate -->

    <owl:DatatypeProperty rdf:about="https://schema.org/orderDate">
        <rdfs:domain rdf:resource="https://schema.org/Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Date when order is placed</rdfs:comment>
        <rdfs:label>orderDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/postalCode -->

    <owl:DatatypeProperty rdf:about="https://schema.org/postalCode">
        <rdfs:domain rdf:resource="https://schema.org/Address"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Postal code of address</rdfs:comment>
        <rdfs:label>postalCode</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/price -->

    <owl:DatatypeProperty rdf:about="https://schema.org/price">
        <rdfs:domain rdf:resource="https://schema.org/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Shows the price of product</rdfs:comment>
        <rdfs:label>price</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/ratingValue -->

    <owl:DatatypeProperty rdf:about="https://schema.org/ratingValue">
        <rdfs:domain rdf:resource="https://schema.org/Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Rating score</rdfs:comment>
        <rdfs:label>ratingValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/streetAddress -->

    <owl:DatatypeProperty rdf:about="https://schema.org/streetAddress">
        <rdfs:domain rdf:resource="https://schema.org/Address"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Address</rdfs:comment>
        <rdfs:label>streetAddress</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/telephone -->

    <owl:DatatypeProperty rdf:about="https://schema.org/telephone">
        <rdfs:domain rdf:resource="http://purl.org/goodrelations/v1#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedLong"/>
        <rdfs:comment>Person telephone</rdfs:comment>
        <rdfs:label>telephone</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/title -->

    <owl:DatatypeProperty rdf:about="https://schema.org/title">
        <rdfs:domain rdf:resource="https://schema.org/WebPage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Title of webpage</rdfs:comment>
        <rdfs:label>title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/totalPrice -->

    <owl:DatatypeProperty rdf:about="https://schema.org/totalPrice">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Cart"/>
                    <rdf:Description rdf:about="https://schema.org/Order"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>total price for cart items</rdfs:comment>
        <rdfs:label>totalPrice</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/goodrelations/v1#Person -->

    <owl:Class rdf:about="http://purl.org/goodrelations/v1#Person">
        <rdfs:comment>representing each human being in ecomm</rdfs:comment>
        <rdfs:label>Person</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Administrator -->

    <owl:Class rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Administrator">
        <rdfs:subClassOf rdf:resource="http://purl.org/goodrelations/v1#Person"/>
        <rdfs:comment>Manages customer</rdfs:comment>
        <rdfs:label>Administer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Cart -->

    <owl:Class rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Cart">
        <rdfs:comment>Cart of customer</rdfs:comment>
        <rdfs:label>Cart</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#CartItem -->

    <owl:Class rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#CartItem">
        <rdfs:comment>items in the cart</rdfs:comment>
        <rdfs:label>Cartitem</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Category -->

    <owl:Class rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Category">
        <rdfs:comment>different categories of products</rdfs:comment>
        <rdfs:label>Category</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Customer -->

    <owl:Class rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Customer">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#placesOrder"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://schema.org/Order"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.org/goodrelations/v1#Person"/>
        <rdfs:comment>browse the webpage and order</rdfs:comment>
        <rdfs:label>Customer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#DeliveryAgent -->

    <owl:Class rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#DeliveryAgent">
        <rdfs:subClassOf rdf:resource="http://purl.org/goodrelations/v1#Person"/>
        <rdfs:comment>delivers the ordered items</rdfs:comment>
        <rdfs:label>DeliveryAgent</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Inventory -->

    <owl:Class rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Inventory">
        <rdfs:comment>list of products</rdfs:comment>
        <rdfs:label>Inventory</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Payment -->

    <owl:Class rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Payment">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Refund"/>
        <rdfs:comment>payments of the order</rdfs:comment>
        <rdfs:label>Payment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Purchase -->

    <owl:Class rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Purchase">
        <owl:equivalentClass rdf:resource="https://schema.org/Order"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Refund -->

    <owl:Class rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Refund">
        <rdfs:comment>returned amount</rdfs:comment>
        <rdfs:label>Refund</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#ReturnRequest -->

    <owl:Class rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#ReturnRequest">
        <rdfs:comment>request to return</rdfs:comment>
        <rdfs:label>ReturnRequest</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Seller -->

    <owl:Class rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Seller">
        <rdfs:subClassOf rdf:resource="http://purl.org/goodrelations/v1#Person"/>
        <rdfs:comment>sells products</rdfs:comment>
        <rdfs:label>Seller</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Staff -->

    <owl:Class rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Staff">
        <rdfs:subClassOf rdf:resource="http://purl.org/goodrelations/v1#Person"/>
        <rdfs:comment>staff manages order</rdfs:comment>
        <rdfs:label>Staff</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Supplier -->

    <owl:Class rdf:about="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#Supplier">
        <rdfs:subClassOf rdf:resource="http://purl.org/goodrelations/v1#Person"/>
        <rdfs:comment>supplies product to seller</rdfs:comment>
        <rdfs:label>Supplier</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/Address -->

    <owl:Class rdf:about="https://schema.org/Address">
        <rdfs:comment>Address of customer or organization</rdfs:comment>
        <rdfs:label>Address</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/Brand -->

    <owl:Class rdf:about="https://schema.org/Brand">
        <rdfs:subClassOf rdf:resource="https://schema.org/Organization"/>
        <rdfs:comment>Name of Brand</rdfs:comment>
        <rdfs:label>Brand</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/DeliveryMethod -->

    <owl:Class rdf:about="https://schema.org/DeliveryMethod">
        <rdfs:comment>Different type of delivery for customer needs</rdfs:comment>
        <rdfs:label>DeliveryMethod</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/Invoice -->

    <owl:Class rdf:about="https://schema.org/Invoice">
        <rdfs:comment>Bill of the order</rdfs:comment>
        <rdfs:label>Invoice</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/Order -->

    <owl:Class rdf:about="https://schema.org/Order">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#contains"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://schema.org/OrderItem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>purchase of customer</rdfs:comment>
        <rdfs:label>Order</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/OrderItem -->

    <owl:Class rdf:about="https://schema.org/OrderItem">
        <rdfs:comment>items customer purchased</rdfs:comment>
        <rdfs:label>OrderItem</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/OrderStatus -->

    <owl:Class rdf:about="https://schema.org/OrderStatus">
        <rdfs:comment>status of the order</rdfs:comment>
        <rdfs:label>OrderStatus</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/Organization -->

    <owl:Class rdf:about="https://schema.org/Organization">
        <rdfs:comment>organization that handles the brand</rdfs:comment>
        <rdfs:label>Organization</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/ParcelDelivery -->

    <owl:Class rdf:about="https://schema.org/ParcelDelivery">
        <rdfs:comment>delivery of products</rdfs:comment>
        <rdfs:label>ParcelDelivery</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/PaymentMethod -->

    <owl:Class rdf:about="https://schema.org/PaymentMethod">
        <rdfs:comment>different modes of payment</rdfs:comment>
        <rdfs:label>PaymentMethod</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/Product -->

    <owl:Class rdf:about="https://schema.org/Product">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/itccl/ontologies/2026/3/untitled-ontology-47#belongsTo"/>
